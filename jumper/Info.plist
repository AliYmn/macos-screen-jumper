    <string>Screen Jumper needs to control your computer to move the cursor between screens.</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>Screen Jumper needs accessibility permissions to detect keyboard shortcuts when other apps are active.</string>
    <key>NSAppleScriptEnabled</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
